// Confera data model (ADR-06).
// The schema changes only through committed migrations in prisma/migrations (NFR-OPS-02):
// `prisma migrate deploy` applies them, `prisma db push` is never used.
// Row-level security, grants and composite foreign keys are written by hand in the
// migration SQL, because Prisma cannot express policies.
//
// Rules for every tenant table (ADR-05; the catalogue test ST-07 enforces them):
// - a column `organisation_id`, and row-level security enabled AND forced, with a policy
//   that has both the read and the write check;
// - a unique key on (organisation_id, id), so that other tables can point at it;
// - a foreign key to another tenant table is composite on (organisation_id, id);
// - explicit grants to confera_app, and to confera_system only what a resolver reads.
//
// Two reviewed kinds of table have no organisation (test/integration/support/catalogue.ts):
// - reference tables (roles, role_permissions): seeded by migration, the same for every
//   organisation, read-only for the run-time roles;
// - instance tables (security_events): what happens before an organisation is known
//   (a failed sign-in for an unknown address); their policy admits a statement only
//   while NO organisation is set, so tenant code can never read or write them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  // Imports without a file extension, so that the compiler and Jest resolve them alike.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// The tenant. Its policy compares `id`, so an organisation sees only itself.
model Organisation {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Issuer data printed on documents (FR-ORG-03). Entered by an admin, never seeded.
  legalName               String?   @map("legal_name")
  address                 String?
  registrationNumber      String?   @map("registration_number")
  taxNumber               String?   @map("tax_number")
  contactEmail            String?   @map("contact_email") @db.Citext
  vatNoteSr               String?   @map("vat_note_sr")
  vatNoteEn               String?   @map("vat_note_en")
  /// Payment details: changed only with the password again, and announced to all admins.
  rsdAccount              String?   @map("rsd_account")
  eurIban                 String?   @map("eur_iban")
  eurSwift                String?   @map("eur_swift")
  eurBankName             String?   @map("eur_bank_name")
  paypalPayee             String?   @map("paypal_payee") @db.Citext
  /// Who changed the payment details last, and when (the banner of FR-ORG-03, 0.6.0).
  paymentDetailsChangedAt DateTime? @map("payment_details_changed_at") @db.Timestamptz(3)
  paymentDetailsChangedBy String?   @map("payment_details_changed_by") @db.Uuid
  /// Raised by every change; a change that names an older version is refused (409).
  version                 Int       @default(1)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Whether the mail log keeps the subject and body of what was sent (FR-SMTP-04).
  mailLogContent          Boolean   @default(true) @map("mail_log_content")
  /// The send breaker of the organisation (ADR-08): confirmation emails of all its forms
  /// above these counts are held for an admin.
  breakerPerHour          Int       @default(30) @map("breaker_per_hour")
  breakerPerDay           Int       @default(200) @map("breaker_per_day")

  users              User[]
  userRoles          UserRole[]
  sessions           Session[]
  knownDevices       KnownDevice[]
  secureLinks        SecureLink[]
  mailMessages       MailMessage[]
  auditEntries       AuditEntry[]
  mailServers        MailServer[]
  conferences        Conference[]
  templates          MailTemplate[]
  mailLog            MailLogEntry[]
  forms              Form[]
  formVersions       FormVersion[]
  formTokens         FormToken[]
  deadlines          ConferenceDeadline[]
  deadlineChanges    ConferenceDeadlineChange[]
  submissions        Submission[]
  submissionAuthors  SubmissionAuthor[]
  submissionStatuses SubmissionStatusChange[]
  files              StoredFile[]

  @@map("organisations")
}

/// An outgoing mail server of the organisation (ADR-11, FR-SMTP-01 to 03). The password is
/// stored sealed (secret-box.ts), never returned, and cleared when host, port, user or TLS
/// mode change.
model MailServer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  name              String
  host              String
  port              Int
  /// implicit (TLS from the first byte, port 465), starttls, or none (local and test stages only).
  tlsMode           String    @map("tls_mode")
  username          String?
  /// The sealed password; null when none is set or it was cleared.
  passwordSealed    String?   @map("password_sealed")
  passwordSetAt     DateTime? @map("password_set_at") @db.Timestamptz(3)
  /// The address the messages come from.
  fromAddress       String    @map("from_address") @db.Citext
  fromName          String    @map("from_name")
  isDefault         Boolean   @default(false) @map("is_default")
  isFallback        Boolean   @default(false) @map("is_fallback")
  enabled           Boolean   @default(true)
  /// Messages a minute that the worker sends through this server at most.
  sendRatePerMinute Int       @default(30) @map("send_rate_per_minute")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  version           Int       @default(1)

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conferences  Conference[]
  templates    MailTemplate[]

  @@unique([organisationId, id])
  @@map("mail_servers")
}

/// A conference, one edition (ADR-06, FR-CONF-01 to 05). The forms, fee list, deadlines and
/// numbering arrive with their modules; the listed sites are what may frame its forms.
model Conference {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  name                String
  /// Two capital letters: the code of the series (IT, ER, EM, LI, AI).
  code                String
  editionYear         Int?      @map("edition_year")
  startsOn            DateTime? @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  venue               String?
  /// The origins of the sites that may embed the conference's forms (https; validated).
  listedSites         String[]  @default([]) @map("listed_sites")
  /// The languages offered: en, sr.
  languages           String[]  @default(["en"])
  timeZone            String    @default("Europe/Belgrade") @map("time_zone")
  /// draft, open (the forms take submissions: "Open for submissions"), closed, archived.
  state               String    @default("draft")
  mailServerId        String?   @map("mail_server_id") @db.Uuid
  /// The links of the consent on its forms (D6): terms of publication and privacy notice, https.
  publicationTermsUrl String?   @map("publication_terms_url")
  privacyNoticeUrl    String?   @map("privacy_notice_url")
  /// The last number given to a submission reference of this conference.
  submissionCounter   Int       @default(0) @map("submission_counter")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  version             Int       @default(1)

  organisation    Organisation               @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  /// A mail server in use by a conference is not deleted (409 mail_server_in_use).
  mailServer      MailServer?                @relation(fields: [organisationId, mailServerId], references: [organisationId, id], onDelete: Restrict)
  messages        MailMessage[]
  templates       MailTemplate[]
  forms           Form[]
  deadlines       ConferenceDeadline[]
  deadlineChanges ConferenceDeadlineChange[]
  submissions     Submission[]

  @@unique([organisationId, id])
  @@unique([organisationId, code, editionYear])
  @@map("conferences")
}

/// An email template (ADR-12): a document as data, per type and language, of the
/// organisation or overriding it for one conference.
model MailTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  conferenceId   String?  @map("conference_id") @db.Uuid
  type           String
  language       String
  subject        Json
  body           Json
  /// The mail server of this template, first in the order of FR-SMTP-02.
  mailServerId   String?  @map("mail_server_id") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  version        Int      @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conference   Conference?  @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Cascade)
  mailServer   MailServer?  @relation(fields: [organisationId, mailServerId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([organisationId, conferenceId, type, language])
  @@map("mail_templates")
}

/// The mail log (ADR-13, FR-SMTP-04): one entry per attempt, with the content sent and
/// every secure link as `[link]`.
model MailLogEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  mailServerId   String?  @map("mail_server_id") @db.Uuid
  /// The name of the server when it was used: the log outlives the server.
  serverName     String?  @map("server_name")
  recipient      String   @db.Citext
  /// The template: its type and language.
  kind           String
  language       String
  conferenceId   String?  @map("conference_id") @db.Uuid
  attempt        Int
  /// sent or failed.
  result         String
  errorCode      String?  @map("error_code")
  subject        String?
  bodyHtml       String?  @map("body_html")
  bodyText       String?  @map("body_text")
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  message      MailMessage  @relation(fields: [organisationId, messageId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, sentAt])
  @@map("mail_log")
}

/// A member of staff. One organisation per user in the MVP (ADR-06, decision z).
/// The email is unique across the instance; it is how sign-in finds the organisation.
model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String    @map("organisation_id") @db.Uuid
  email                  String    @unique @db.Citext
  displayName            String    @map("display_name")
  /// Null until the invitation is accepted. Never returned by the API, never granted to the system role.
  passwordHash           String?   @map("password_hash")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// invited (no password yet), active, deactivated, removed (kept for the attribution of past actions).
  status                 String    @default("invited")
  passwordChangedAt      DateTime? @map("password_changed_at") @db.Timestamptz(3)
  /// The second factor of 0.9.0 (ADR-03, G2-16). Null: not enrolled.
  secondFactorEnrolledAt DateTime? @map("second_factor_enrolled_at") @db.Timestamptz(3)
  /// Raised by every change; a change that names an older version is refused (409).
  version                Int       @default(1)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  organisation          Organisation               @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roles                 UserRole[]
  sessions              Session[]
  knownDevices          KnownDevice[]
  secureLinks           SecureLink[]
  auditEntries          AuditEntry[]
  publishedFormVersions FormVersion[]
  deadlineChanges       ConferenceDeadlineChange[]
  releasedMessages      MailMessage[]              @relation("ReleasedMessages")

  @@unique([organisationId, id])
  @@map("users")
}

/// A role of a user. The row carries the organisation, and the composite foreign key makes
/// it equal the user's (ADR-06): a role row can never point into another organisation.
model UserRole {
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)
  roleRef      Role         @relation(fields: [role], references: [name], onDelete: Restrict)

  @@id([organisationId, userId, role])
  @@map("user_roles")
}

/// The roles of the MVP (ADR-05, FR-USR-01): a reference table, seeded by migration.
model Role {
  name        String           @id
  description String
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

/// What a role may do: the permissions are code constants (src/modules/access/permissions.ts),
/// and this reference table, seeded by migration, gives them to the roles.
model RolePermission {
  role       String
  permission String
  roleRef    Role   @relation(fields: [role], references: [name], onDelete: Restrict)

  @@id([role, permission])
  @@map("role_permissions")
}

/// A signed-in session (ADR-03). The cookie holds a random token; only its SHA-256 is here.
model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  /// SHA-256 of the token in the cookie, hexadecimal.
  tokenHash           String    @unique @map("token_hash")
  /// The known device the session was signed in from, when there was one.
  deviceId            String?   @map("device_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// 24 hours after the last use, and never after the absolute end.
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  /// 7 days after sign-in (G2-24).
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// The last time the password was asked again in this session; valid 5 minutes.
  passwordConfirmedAt DateTime? @map("password_confirmed_at") @db.Timestamptz(3)
  /// not_required, pending or passed: the step of the second factor (built in 0.9.0).
  secondFactor        String    @default("not_required") @map("second_factor")
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(3)
  endReason           String?   @map("end_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, userId])
  @@map("sessions")
}

/// A browser that has signed in to an account before (ADR-03): exempt from the account brake.
/// The device cookie holds a random token bound to the account; only its SHA-256 is here.
model KnownDevice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @map("token_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, userId, tokenHash])
  @@map("known_devices")
}

/// A secure link (ADR-04): one purpose, a subject, a recipient, an expiry; used once, by a POST.
/// The token exists only in the email that carries it; only its SHA-256 is here.
model SecureLink {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// invitation, password_reset or email_change.
  purpose        String
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  /// The address the link was sent to: for email_change the new address.
  recipient      String    @db.Citext
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organisationId, userId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, userId, purpose])
  @@map("secure_links")
}

/// The mail outbox (ADR-13): a message is queued in the same transaction as the change that
/// causes it, with a unique key. One recipient per row. A link is never stored: the row says
/// which link to make (purpose and user), and the worker of 0.2.0 part B makes it at send time.
model MailMessage {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  uniqueKey        String    @map("unique_key")
  /// The kind of message, which names its template (invitation, password_reset, ...).
  kind             String
  recipientUserId  String?   @map("recipient_user_id") @db.Uuid
  recipientAddress String    @map("recipient_address") @db.Citext
  /// The link the message carries, made at send time: its purpose and the user it is for.
  linkPurpose      String?   @map("link_purpose")
  linkUserId       String?   @map("link_user_id") @db.Uuid
  /// What the template needs besides the link: ids and fixed codes, never a token.
  parameters       Json      @default("{}")
  /// queued, sending, sent, failed, held (by the send breaker of 0.3.0), stuck (left in sending by a crash),
  /// waiting_for_server (no mail server can send it yet; a change of the mail servers makes it due).
  status           String    @default("queued")
  /// The language of the recipient: en or sr.
  language         String    @default("en")
  /// The conference the message is about, which chooses its templates and mail server.
  conferenceId     String?   @map("conference_id") @db.Uuid
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz(3)
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(3)
  lastErrorCode    String?   @map("last_error_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The form and the submission a message is about (a confirmation): for the send breaker.
  formId           String?   @map("form_id") @db.Uuid
  submissionId     String?   @map("submission_id") @db.Uuid
  /// Why a `held` message waits for an admin: send_breaker_form, send_breaker_organisation, recipient_domain.
  heldReason       String?   @map("held_reason")
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(3)
  releasedBy       String?   @map("released_by") @db.Uuid

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  log          MailLogEntry[]
  conference   Conference?    @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Restrict)
  form         Form?          @relation(fields: [organisationId, formId], references: [organisationId, id], onDelete: Restrict)
  submission   Submission?    @relation(fields: [organisationId, submissionId], references: [organisationId, id], onDelete: Restrict)
  releaser     User?          @relation("ReleasedMessages", fields: [organisationId, releasedBy], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([organisationId, uniqueKey])
  @@index([status, nextAttemptAt])
  @@index([organisationId, recipientUserId, kind, createdAt])
  @@index([organisationId, formId, createdAt])
  @@index([organisationId, submissionId])
  @@map("mail_outbox")
}

/// The audit log (ADR-06, FR-AUD-01 to 03): insert-only for both run-time roles. Old and new
/// values only for the fields on the list in code (src/modules/audit/audit-fields.ts).
model AuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Who did it; null for the system (a summary, a job).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  subjectType    String   @map("subject_type")
  subjectId      String?  @map("subject_id") @db.Uuid
  /// The names of the fields that changed.
  fields         String[] @default([])
  /// Old and new value of the listed fields only: { field: { old, new } }.
  changes        Json     @default("{}")
  /// Counts and periods of a summary; never a personal value.
  detail         Json     @default("{}")
  traceId        String?  @map("trace_id") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [organisationId, actorUserId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, occurredAt])
  @@map("audit_entries")
}

/// Security events of the instance (ADR-06, ADR-29): failed sign-ins, for the brake and for
/// the summary in the audit log. An instance table: read and written only while no
/// organisation is set. Kept 90 days.
model SecurityEvent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt         DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// sign_in_failed or password_confirmation_failed.
  kind               String
  /// The one-hop client address (ADR-03).
  clientAddress      String    @map("client_address")
  /// The account, when the address belongs to one; null for an unknown address.
  userOrganisationId String?   @map("user_organisation_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  /// The attempt came from a browser that is a known device of that account.
  knownDevice        Boolean   @default(false) @map("known_device")
  /// When the summary of the audit log counted it (unknown addresses only).
  summarisedAt       DateTime? @map("summarised_at") @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([clientAddress, occurredAt])
  @@map("security_events")
}

/// A form of a conference (ADR-06, ADR-09; FR-FORM-01, FR-FORM-02): one per type. Its
/// configuration is the admin's draft over the field catalogue in code; publishing makes an
/// immutable version of the definition built from it. The public key is its address.
model Form {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  conferenceId     String   @map("conference_id") @db.Uuid
  /// abstract (0.3.0); full_paper and membership arrive with their milestones.
  type             String
  /// The form's address in /f/<key> and /embed/<key>: 16 random letters and digits.
  publicKey        String   @unique @map("public_key")
  /// The draft: what the admin set over the catalogue (src/modules/forms/configuration.ts).
  configuration    Json
  /// The version the public form shows; null until the first publish.
  currentVersionId String?  @map("current_version_id") @db.Uuid
  /// The send breaker of this form (ADR-08): confirmations above these counts are held.
  breakerPerHour   Int      @default(30) @map("breaker_per_hour")
  breakerPerDay    Int      @default(200) @map("breaker_per_day")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  version          Int      @default(1)

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conference     Conference    @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Restrict)
  currentVersion FormVersion?  @relation("CurrentVersion", fields: [organisationId, currentVersionId], references: [organisationId, id], onDelete: Restrict)
  versions       FormVersion[] @relation("Versions")
  tokens         FormToken[]
  submissions    Submission[]
  messages       MailMessage[]

  @@unique([organisationId, id])
  @@unique([organisationId, conferenceId, type])
  @@map("forms")
}

/// A published version of a form (ADR-06): never changed (the application role may only
/// read and add rows). A submission keeps the version it was made with.
model FormVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  number         Int
  /// The definition the public form renders and the server checks (contracts/form-definition.schema.json).
  definition     Json
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy    String?  @map("published_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  form         Form         @relation("Versions", fields: [organisationId, formId], references: [organisationId, id], onDelete: Restrict)
  publisher    User?        @relation(fields: [organisationId, publishedBy], references: [organisationId, id], onDelete: Restrict)
  currentOf    Form[]       @relation("CurrentVersion")
  tokens       FormToken[]
  submissions  Submission[]

  @@unique([organisationId, id])
  @@unique([organisationId, formId, number])
  @@map("form_versions")
}

/// A single-use form token (ADR-08): fetched by the form page, sent in a header with every
/// upload and the submit. Only its SHA-256 is here. Its uploads are bound to it; unattached
/// files are purged when it expires.
model FormToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  formVersionId  String    @map("form_version_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  /// Uploads made with it so far (at most the file fields of the version, plus a margin).
  uploads        Int       @default(0)
  /// The proof-of-work it asks for, when it was issued under load (ADR-08).
  /// When the author began to fill in the form: the issue of the first token of a chain of
  /// renewals (Q3-01). The minimum fill time is measured from here.
  fillStartedAt  DateTime? @map("fill_started_at") @db.Timestamptz(3)
  /// The token this one renews, when the page renewed a refused one (Q3-01).
  renewedFrom    String?   @map("renewed_from") @db.Uuid
  /// When a submit was refused for its proof-of-work: the page renews it although it is
  /// not expired (Q3-02); a live token is never renewed (SEC-M3-02).
  refusedAt      DateTime? @map("refused_at") @db.Timestamptz(3)
  powChallenge   String?   @map("pow_challenge")
  powDifficulty  Int?      @map("pow_difficulty")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  form         Form         @relation(fields: [organisationId, formId], references: [organisationId, id], onDelete: Cascade)
  formVersion  FormVersion  @relation(fields: [organisationId, formVersionId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, tokenHash])
  @@index([organisationId, expiresAt])
  @@map("form_tokens")
}

/// A deadline of a conference (FR-DL-01 to 03): the last day, in the conference's time zone.
model ConferenceDeadline {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  conferenceId   String   @map("conference_id") @db.Uuid
  /// abstract_submission, fee_payment or full_paper.
  kind           String
  /// The last day it is open: it ends at the end of that day in the conference's time zone.
  endsOn         DateTime @map("ends_on") @db.Date
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  version        Int      @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conference   Conference   @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, conferenceId, kind])
  @@map("conference_deadlines")
}

/// The history of a deadline (FR-DL-03): every setting and extension, with the old and the
/// new day and who changed it. Insert-only for the application role.
model ConferenceDeadlineChange {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  conferenceId   String    @map("conference_id") @db.Uuid
  kind           String
  oldEndsOn      DateTime? @map("old_ends_on") @db.Date
  newEndsOn      DateTime  @map("new_ends_on") @db.Date
  changedAt      DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedBy      String?   @map("changed_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conference   Conference   @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Cascade)
  changer      User?        @relation(fields: [organisationId, changedBy], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, conferenceId, changedAt])
  @@map("conference_deadline_changes")
}

/// A submission (ADR-06, FR-SUB-01): everything the author typed under stable keys, the
/// language, the form version, the consent, and typed columns for what is listed and
/// filtered. Written once, in the transaction of the submit (ADR-08).
model Submission {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId         String   @map("organisation_id") @db.Uuid
  conferenceId           String   @map("conference_id") @db.Uuid
  formId                 String   @map("form_id") @db.Uuid
  formVersionId          String   @map("form_version_id") @db.Uuid
  /// Shown to the author and the admin, unique in the organisation: IT27-0001.
  reference              String
  /// en or sr: the language of every later email to the author (FR-FORM-09).
  language               String
  /// received (0.3.0); the statuses of FR-SUB-05 arrive with 0.4.0.
  status                 String   @default("received")
  /// The answers by field key, as checked by the rule interpreter.
  answers                Json
  title                  String?
  participationType      String?  @map("participation_type")
  firstAuthorName        String   @map("first_author_name")
  firstAuthorInstitution String?  @map("first_author_institution")
  correspondingEmail     String   @map("corresponding_email") @db.Citext
  /// The domain of that address, for the limit per recipient domain (ADR-08).
  correspondingDomain    String   @map("corresponding_domain") @db.Citext
  authorCount            Int      @map("author_count")
  /// The consent as it was shown (FR-FORM-11, NFR-PRIV-02): its text, its links, a hash of both, and when.
  consentText            String   @map("consent_text")
  consentLinks           Json     @default("{}") @map("consent_links")
  consentVersion         String   @map("consent_version")
  consentedAt            DateTime @map("consented_at") @db.Timestamptz(3)
  idempotencyKey         String   @map("idempotency_key") @db.Uuid
  /// SHA-256 of the request, so that a repeated key with another body is told apart.
  payloadHash            String   @map("payload_hash")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conference   Conference               @relation(fields: [organisationId, conferenceId], references: [organisationId, id], onDelete: Restrict)
  form         Form                     @relation(fields: [organisationId, formId], references: [organisationId, id], onDelete: Restrict)
  formVersion  FormVersion              @relation(fields: [organisationId, formVersionId], references: [organisationId, id], onDelete: Restrict)
  authors      SubmissionAuthor[]
  statuses     SubmissionStatusChange[]
  files        StoredFile[]
  messages     MailMessage[]

  @@unique([organisationId, id])
  @@unique([organisationId, reference])
  @@unique([organisationId, formId, idempotencyKey])
  @@index([organisationId, receivedAt])
  @@index([organisationId, conferenceId, receivedAt])
  @@index([organisationId, correspondingDomain, receivedAt])
  @@map("submissions")
}

/// An author of a submission, in the order typed (FR-FORM-03). The first is the corresponding author.
model SubmissionAuthor {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String  @map("organisation_id") @db.Uuid
  submissionId       String  @map("submission_id") @db.Uuid
  /// 1, 2, 3 ...
  position           Int
  firstName          String  @map("first_name")
  lastName           String  @map("last_name")
  institution        String?
  institutionAddress String? @map("institution_address")
  orcid              String?
  email              String  @db.Citext
  phone              String?
  isCorresponding    Boolean @default(false) @map("is_corresponding")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  submission   Submission   @relation(fields: [organisationId, submissionId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, submissionId, position])
  @@map("submission_authors")
}

/// The status history of a submission (ADR-08): its first row is written with it. Insert-only.
model SubmissionStatusChange {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  status         String
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  /// Who changed it; null for the author's own submit.
  actorUserId    String?  @map("actor_user_id") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  submission   Submission   @relation(fields: [organisationId, submissionId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, submissionId, changedAt])
  @@map("submission_status_history")
}

/// A stored file (ADR-10): on the private volume under a key that never holds the client's
/// name; the type detected from the content; the SHA-256; the scan state. Served only by
/// the endpoint that decides by its owner and kind.
model StoredFile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// submission_file (0.3.0).
  kind           String
  /// org/<organisation>/<uuid>: never the client's file name.
  storageKey     String    @unique @map("storage_key")
  /// The name the person's computer gave it, NFC, for display and download (FR-FILE-03).
  originalName   String    @map("original_name")
  /// pdf, docx, doc, jpeg or png: what the content is.
  detectedType   String    @map("detected_type")
  sizeBytes      Int       @map("size_bytes")
  sha256         String
  /// pending, clean, infected or not_clean (a limit of the scanner was exceeded).
  scanState      String    @default("pending") @map("scan_state")
  /// macros: an old .doc that holds macros, accepted and flagged for the office (G2-22).
  scanFlag       String?   @map("scan_flag")
  /// What the scanner said, as a code.
  scanDetail     String?   @map("scan_detail")
  scanAttempts   Int       @default(0) @map("scan_attempts")
  nextScanAt     DateTime  @default(now()) @map("next_scan_at") @db.Timestamptz(3)
  scannedAt      DateTime? @map("scanned_at") @db.Timestamptz(3)
  /// The form token it was uploaded with (ADR-10).
  formTokenId    String?   @map("form_token_id") @db.Uuid
  /// The file field of the form version it was uploaded for.
  fieldKey       String?   @map("field_key")
  submissionId   String?   @map("submission_id") @db.Uuid
  attachedAt     DateTime? @map("attached_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  submission   Submission?  @relation(fields: [organisationId, submissionId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, submissionId])
  @@index([organisationId, formTokenId])
  @@index([organisationId, scanState, nextScanAt])
  @@map("files")
}
