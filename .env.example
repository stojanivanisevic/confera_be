# Confera API: environment of a developer machine.
#
# Copy this file to .env (git ignores .env) and start working; the values below work
# with the development stack of docker-compose.yml as they are.
# Nothing in this file is a secret: every password is a "local-only-" placeholder for the
# local Docker database. Real values never go into git.
#
# The application reads its variables only through src/config, which refuses to start
# on a missing or invalid value and names the variable.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Where this process runs: local, dev, test or prod. No default; anything else stops the start.
# local, dev and test run only on a developer machine. Every server runs prod.
STAGE=local

# On STAGE=prod only, and required there: production or staging. No default.
# It must not be set on a developer machine.
# INSTANCE=staging

# Port the API listens on. Default 3001.
PORT=3001

# Address the API listens on. Default 127.0.0.1 outside prod and 0.0.0.0 on prod.
# LISTEN_HOST=127.0.0.1

# Origin of the admin surface, as the browser sees it. /api/v1 answers only under this host name.
ADMIN_ORIGIN=http://localhost:3000

# Origin of the public surface (forms, embed, secure-link pages). /public/v1 answers only
# under this host name. It must be another host name than ADMIN_ORIGIN; on a developer
# machine "localhost" and "127.0.0.1" are two host names for the same computer.
PUBLIC_ORIGIN=http://127.0.0.1:3000

# PostgreSQL address of the APPLICATION role (confera_app): no schema rights, bound by row-level security.
DATABASE_URL=postgresql://confera_app:local-only-app@127.0.0.1:5432/confera

# PostgreSQL address of the SYSTEM role (confera_system): used only by the resolvers that
# find an organisation before one is known.
SYSTEM_DATABASE_URL=postgresql://confera_system:local-only-system@127.0.0.1:5432/confera

# Lowest level that is logged: fatal, error, warn, info, debug or trace. Default info.
# LOG_LEVEL=info

# The data key (ADR-11): the passwords of the mail servers are stored encrypted under a key
# derived from it. 43 to 128 characters of letters, digits, - and _: on a server 32 random
# bytes in base64url, held off the server by two people. This one is for the local stack.
DATA_KEY=local-only-data-key-of-the-development-stack-0123456789ab

# How often the mail worker looks at the outbox, in seconds. Default 5; 0 switches it off.
# MAIL_WORKER_INTERVAL_SECONDS=5

# How often the background jobs run (virus scans, purge of unattached uploads), in seconds.
# Default 30; 0 switches them off.
# JOBS_INTERVAL_SECONDS=30

# The private folder of the uploaded files (ADR-10). Default: tmp/files of this checkout.
# Required on a server.
# FILE_STORAGE_DIR=tmp/files

# host:port of the ClamAV daemon (clamd) that scans attached files. The development stack
# has none: without it every file stays "scan pending" and is never served (fail closed).
# Required on a server.
# CLAMAV_ADDRESS=127.0.0.1:3310

# ---------------------------------------------------------------------------
# Development conveniences
# ---------------------------------------------------------------------------
# A DEV_ variable is accepted only on STAGE=local or dev. On test and prod it stops the
# start, and so does any DEV_ variable that the schema does not know, on every stage.
# The code behind them exists only in the development build (pnpm start:dev).

# true serves the interactive API documentation.
# DEV_API_DOCS=true

# true logs every SQL statement.
# DEV_LOG_QUERIES=true

# ---------------------------------------------------------------------------
# Development stack of this checkout (docker-compose.yml; never read by the running API)
# ---------------------------------------------------------------------------
# Every checkout has a stack of its own (README, section 2). PostgreSQL listens on the
# port of the three database addresses of this file. On a second checkout run
# `corepack pnpm stack:ports`: it writes a free set of ports, derived from the folder of
# the checkout, into the addresses and into the two lines below.

# Port of the web screen of the mail catcher (Mailpit) on 127.0.0.1.
CONFERA_MAIL_WEB_PORT=8025

# SMTP port of the mail catcher on 127.0.0.1.
CONFERA_MAIL_SMTP_PORT=1025

# Name of the Docker Compose project of this checkout. Default: derived from the folder of
# the checkout (`corepack pnpm stack:info` shows it).
# CONFERA_STACK_NAME=confera-mine

# ---------------------------------------------------------------------------
# Tools (never read by the running API)
# ---------------------------------------------------------------------------

# Password of the PostgreSQL superuser "postgres" in the development stack (docker-compose.yml).
POSTGRES_PASSWORD=local-only-superuser

# PostgreSQL address of the OWNER role (confera_owner). Used only by `prisma migrate deploy`.
MIGRATION_DATABASE_URL=postgresql://confera_owner:local-only-owner@127.0.0.1:5432/confera

# Superuser address that `db:provision` uses instead of the development stack's "postgres"
# with POSTGRES_PASSWORD: for a database that is not the stack of this checkout.
# PROVISION_DATABASE_URL=postgresql://postgres:local-only-superuser@127.0.0.1:5432/postgres

# Port of the stub slot (`corepack pnpm stubs`) on 127.0.0.1. Default 4010.
# STUBS_PORT=4010
