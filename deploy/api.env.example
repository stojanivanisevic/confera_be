# Confera API and worker: environment template of a SERVER (staging or production).
#
# A template only. The operator fills in the values on the server, in CONFERA_CONFIG_DIR/api.env
# (root, mode 0644); the API and the worker read the same file. A value never goes into git and
# never into a pipeline variable (ADR-26, ADR-27). The variables are explained in .env.example
# and src/config.
#
# The SECRETS are not in this file: each is a file of its own that deploy/compose.yml gives to
# the API and the worker only, mounted under /run/secrets (ADR-26): database_url,
# system_database_url and data_key. README section 15 says how to make them.
#
# deploy/compose.yml sets what the topology fixes: INSTANCE (from compose.env), PORT,
# LISTEN_HOST, FILE_STORAGE_DIR, CLAMAV_ADDRESS, and the worker intervals (the API runs no worker).
#
# This file must never hold a development convenience or a credential of the migration
# job; test/architecture/production-env-template.spec.ts checks it (ST-04).

# Every server runs the production stage, the staging server included.
STAGE=prod

# Origin of the admin surface, https only: https://<CONFERA_ADMIN_HOST of compose.env>.
ADMIN_ORIGIN=

# Origin of the public surface, https only, another host name than the admin's:
# https://<CONFERA_PUBLIC_HOST of compose.env>.
PUBLIC_ORIGIN=

# Lowest level that is logged on a server: fatal, error, warn or info. Default info.
# LOG_LEVEL=info
