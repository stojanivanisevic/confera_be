# Confera API and worker: environment template of a SERVER (staging or production).
#
# A template only. The operator fills in the values on the server, in the secret file of
# the service; a value never goes into git and never into a pipeline variable
# (ADR-26, ADR-27). The variables are explained in .env.example and src/config.
#
# This file must never hold a development convenience or a credential of the migration
# job; test/architecture/production-env-template.spec.ts checks it (ST-04).

# Every server runs the production stage, the staging server included.
STAGE=prod

# Required: production or staging. No default; a missing or misspelt value stops the start.
INSTANCE=

# Port the API listens on inside its container.
PORT=3001

# Origin of the admin surface, https only, for example https://admin.example.org
ADMIN_ORIGIN=

# Origin of the public surface, https only, another host name than the admin's.
PUBLIC_ORIGIN=

# PostgreSQL address of the APPLICATION role (confera_app). Secret.
DATABASE_URL=

# PostgreSQL address of the SYSTEM role (confera_system). Secret.
SYSTEM_DATABASE_URL=

# The data key (ADR-11): 32 random bytes in base64url, held off the server by two people. Secret.
DATA_KEY=

# How often the mail worker looks at the outbox, in seconds. Default 5.
# MAIL_WORKER_INTERVAL_SECONDS=5

# The private folder of the uploaded files (ADR-10), on a volume of its own. Required.
FILE_STORAGE_DIR=

# host:port of the ClamAV daemon (clamd) that scans the attached files. Required.
CLAMAV_ADDRESS=

# Staging only, and required there (ADR-27, ST-50): host:port of the mail catcher. Every
# message then goes to the catcher alone, whatever the recipient and the mail server. A
# production instance refuses the variable.
# STAGING_MAIL_CATCHER=mailpit:1025

# How often the background jobs run (scans, purge of unattached uploads), in seconds. Default 30.
# JOBS_INTERVAL_SECONDS=30

# Lowest level that is logged on a server: fatal, error, warn or info. Default info.
# LOG_LEVEL=info
