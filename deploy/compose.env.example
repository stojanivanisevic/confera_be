# Confera server: the settings of the topology (deploy/compose.yml). M4-BE-07.
#
# A template only. On the server it is /srv/confera/compose.env, owned by root, mode 0644: it
# holds no secret. Secrets are files under CONFERA_SECRETS_DIR (README section 15), never here.
# The image references are not here either: the deploy script writes them into images.env.

# staging or production. Chooses the proxy's gate (deploy/proxy/gate-<instance>.caddy) and is
# the API's INSTANCE. No default.
CONFERA_INSTANCE=

# The two host names (ADR-02, G2-18), without scheme and port, for example admin.example.org
# and forms.example.org. They must be the host names of ADMIN_ORIGIN and PUBLIC_ORIGIN in
# api.env and of CONFERA_ADMIN_ORIGIN and CONFERA_PUBLIC_ORIGIN in web.env.
CONFERA_ADMIN_HOST=
CONFERA_PUBLIC_HOST=

# Where the settings of each service live (api.env, web.env, proxy.env), for example /srv/confera/config.
CONFERA_CONFIG_DIR=

# Where the secret files live, one file per secret, for example /srv/confera/secrets.
CONFERA_SECRETS_DIR=

# The proxy's certificates and ACME account: a directory owned by uid 10002, mode 0700,
# for example /srv/confera/proxy-data.
CONFERA_PROXY_DATA_DIR=

# The ports published on the host. 80 and 443 on a server; nothing else is published.
CONFERA_HTTP_PORT=80
CONFERA_HTTPS_PORT=443
