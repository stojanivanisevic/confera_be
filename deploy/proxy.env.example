# Congresa server: the environment of the proxy (deploy/proxy/Caddyfile). M4-BE-07.
#
# A template only. On the server it is CONGRESA_CONFIG_DIR/proxy.env, owned by root, mode 0640.

# Address Let's Encrypt writes to about the certificates, for example ops@example.org.
CONGRESA_ACME_EMAIL=

# The access gate of a STAGING server (deploy/proxy/gate-staging.caddy). Empty on production.
# The user name, and the bcrypt hash of the password made with
#   docker run --rm <the caddy image of deploy/compose.yml> caddy hash-password --bcrypt-cost 10
# from a long random password (the gate checks it on every request; a random password needs no
# high cost).
# Write the hash in single quotes (CONGRESA_GATE_PASSWORD_HASH='$2a$14$...'): Compose would read each
# $ of an unquoted value as the start of a variable. The password itself is never written down on
# the server.
CONGRESA_GATE_USER=
CONGRESA_GATE_PASSWORD_HASH=

# STAGING, phase 2 of the gate (deploy/proxy/gate-staging.caddy): `open` lets the public form
# paths listed there through on the public host without the gate, after M4-QA-03 has passed.
# Anything else, or nothing, keeps every path gated. Recreate the proxy after a change:
#   docker compose ... up --detach --force-recreate --no-deps proxy
CONGRESA_GATE_PUBLIC_PATHS=closed

# STAGING: the mail catcher's own credentials (deploy/proxy/mail-staging.caddy), another user
# and another password than the gate's, the hash made the same way and written in single quotes.
CONGRESA_CATCHER_USER=
CONGRESA_CATCHER_PASSWORD_HASH=
