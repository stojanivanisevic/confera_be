# Congresa server: the environment of the web application (confera_fe). M4-BE-07.
#
# A template only. On the server it is CONGRESA_CONFIG_DIR/web.env, owned by root, mode 0644.
# The web application holds no secret and no database address and must never be given one
# (ADR-20, ADR-26): this file has nothing else to hold. deploy/compose.yml sets STAGE=prod,
# CONGRESA_API_ORIGIN, PORT and LISTEN_HOST itself.

# The two surfaces, https only: https://<CONGRESA_ADMIN_HOST> and https://<CONGRESA_PUBLIC_HOST>.
CONGRESA_ADMIN_ORIGIN=
CONGRESA_PUBLIC_ORIGIN=
