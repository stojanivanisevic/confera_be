# Confera server: the environment of the web application (confera_fe). M4-BE-07.
#
# A template only. On the server it is CONFERA_CONFIG_DIR/web.env, owned by root, mode 0644.
# The web application holds no secret and no database address and must never be given one
# (ADR-20, ADR-26): this file has nothing else to hold. deploy/compose.yml sets STAGE=prod,
# CONFERA_API_ORIGIN, PORT and LISTEN_HOST itself.

# The two surfaces, https only: https://<CONFERA_ADMIN_HOST> and https://<CONFERA_PUBLIC_HOST>.
CONFERA_ADMIN_ORIGIN=
CONFERA_PUBLIC_ORIGIN=
