{
  "name": "confera-be",
  "version": "0.1.0",
  "private": true,
  "description": "Confera API: conferences and membership of UdEkoM Balkans (NestJS, Prisma, PostgreSQL)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "node scripts/build.mjs tsconfig.build.json",
    "build:dev": "node scripts/build.mjs tsconfig.build.dev.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:build": "jest --selectProjects build --passWithNoTests",
    "supply-chain": "node scripts/supply-chain.mjs",
    "check": "node scripts/check.mjs",
    "stack:up": "docker compose up --detach --wait",
    "stack:down": "docker compose down"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fontkit": "2.0.4",
    "nestjs-cls": "7.0.1",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/express": "5.0.6",
    "@types/fontkit": "2.0.9",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "secretlint": "13.0.7",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
