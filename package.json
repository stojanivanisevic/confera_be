{
  "name": "confera-be",
  "version": "0.1.0",
  "private": true,
  "description": "Confera API: conferences and membership of UdEkoM Balkans (NestJS, Prisma, PostgreSQL)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "node scripts/build.mjs tsconfig.build.json",
    "build:dev": "node scripts/build.mjs tsconfig.build.dev.json",
    "openapi:generate": "node scripts/build.mjs tsconfig.build.dev.json && node dist-dev/modules/dev-tools/openapi/generate.js --write",
    "openapi:check": "node scripts/build.mjs tsconfig.build.dev.json && node dist-dev/modules/dev-tools/openapi/generate.js --check",
    "pdf:sample": "node scripts/build.mjs tsconfig.build.dev.json && node dist-dev/modules/dev-tools/pdf-sample.js",
    "start": "node scripts/stack.mjs check-database --tool start DATABASE_URL SYSTEM_DATABASE_URL && node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:build": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects build",
    "test:timing": "node scripts/build.mjs tsconfig.build.dev.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects timing --runInBand",
    "test:int": "node scripts/build.mjs tsconfig.build.json && node scripts/build.mjs tsconfig.build.dev.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:supply-chain": "node scripts/supply-chain-planted.mjs",
    "supply-chain": "node scripts/supply-chain.mjs",
    "check": "node scripts/check.mjs",
    "stack:up": "node scripts/stack.mjs up",
    "stack:down": "node scripts/stack.mjs down",
    "stack:wipe": "node scripts/stack.mjs wipe",
    "stack:ports": "node scripts/stack.mjs ports",
    "stack:info": "node scripts/stack.mjs info",
    "stubs": "node --env-file-if-exists=.env scripts/stubs.mjs",
    "seed:e2e": "node --env-file-if-exists=.env scripts/seed-e2e.mjs",
    "db:provision": "node scripts/db-provision.mjs",
    "db:migrate": "node scripts/stack.mjs check-database --tool db:migrate MIGRATION_DATABASE_URL && prisma migrate deploy",
    "db:status": "node scripts/stack.mjs check-database --tool db:status MIGRATION_DATABASE_URL && prisma migrate status",
    "db:diff": "node scripts/stack.mjs check-database --tool db:diff MIGRATION_DATABASE_URL && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fontkit": "2.0.4",
    "nestjs-cls": "7.0.1",
    "nodemailer": "10.1.0",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/express": "5.0.6",
    "@types/fontkit": "2.0.9",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "secretlint": "13.0.7",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
